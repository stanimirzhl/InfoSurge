@{
    ViewData["Title"] = "Начало";
}
<div class="container py-5">

    <div class="text-center mb-5">
        <h1 class="display-4 fw-bold mb-3">Добре дошли в InfoSurge</h1>
        <p class="lead text-muted">
            Открийте най-новите статии, анализи и новини на едно място.
        </p>
        <a asp-controller="Home" asp-action="AllArticles" class="btn btn-lg btn-primary shadow-sm mt-3">
            <i class="bi bi-newspaper me-2"></i> Разгледайте всички статии
        </a>
    </div>

    <div class="row g-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-lightbulb display-5 text-warning mb-3"></i>
                    <h5 class="fw-bold">Полезни идеи</h5>
                    <p class="text-muted">Четете съвети и анализи от нашите експерти.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-clock-history display-5 text-primary mb-3"></i>
                    <h5 class="fw-bold">Актуална информация</h5>
                    <p class="text-muted">Винаги бъдете в крак с последните събития.</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body text-center">
                    <i class="bi bi-people display-5 text-success mb-3"></i>
                    <h5 class="fw-bold">Общност</h5>
                    <p class="text-muted">Споделяйте мнение и участвайте в дискусии.</p>
                </div>
            </div>
        </div>
    </div>

</div>
