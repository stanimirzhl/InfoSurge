@{
    ViewData["Title"] = "Вътрешна грешка";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 text-center">
            <div class="p-5 shadow-lg border-0 rounded-4" style="background: linear-gradient(135deg, #e0f7fa, #80deea);">
                <div class="mb-4">
                    <i class="bi bi-emoji-frown-fill" style="font-size: 64px; color: #0288d1;"></i>
                </div>
                <h1 class="fw-bold mb-3" style="color: #0277bd;">
                    Грешка при обработване на информацията
                </h1>
                <p class="lead mb-4 fw-medium" style="color: #01579b; font-size: 1.25rem;">
                    Опитайте да презаредите страницата или се върнете на началната страница.
                </p>
                <a asp-controller="Home" asp-action="Index"
                   class="btn btn-lg px-5 py-3"
                   style="background-color: #0288d1; color: white; font-weight: 600; border-radius: 50px; box-shadow: 0 4px 15px rgba(2,136,209,0.4);">
                    <i class="bi bi-house-door-fill me-2"></i> Върни се обратно
                </a>
            </div>
        </div>
    </div>
</div>